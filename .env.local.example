# Anthropic API 키를 여기에 넣어주세요.
# 발급: https://console.anthropic.com  →  Settings → API keys → Create Key
# 이 파일을 .env.local 로 복사한 뒤 값을 채우고, 개발 서버를 재시작하세요.
ANTHROPIC_API_KEY=sk-ant-...

# Replicate API 토큰을 여기에 넣어주세요. (이미지 생성용, Nano Banana 모델 호출)
# 발급: https://replicate.com  →  로그인 →  Account → API tokens → Create token
REPLICATE_API_TOKEN=r8_...

# Supabase 프로젝트 URL과 anon(publishable) key.
# 발급: https://supabase.com/dashboard/project/_/settings/api-keys
# 서버(Route Handler)용
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=sb_publishable_...
# 브라우저(로그인 등 클라이언트 Auth)용 — 값은 위와 동일, NEXT_PUBLIC_ 접두사만 다름
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_...
